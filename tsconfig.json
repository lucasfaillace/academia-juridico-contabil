{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-preview/types/**/*.ts",
    ".next-preview/dev/types/**/*.ts",
    ".next-review/types/**/*.ts",
    ".next-review/dev/types/**/*.ts",
    ".next-review2/types/**/*.ts",
    ".next-review2/dev/types/**/*.ts",
    ".next-review3/types/**/*.ts",
    ".next-review3/dev/types/**/*.ts",
    ".next-review4/types/**/*.ts",
    ".next-review4/dev/types/**/*.ts",
    ".next-review5/types/**/*.ts",
    ".next-review5/dev/types/**/*.ts",
    ".next-review6/types/**/*.ts",
    ".next-review6/dev/types/**/*.ts",
    ".next-review7/types/**/*.ts",
    ".next-review7/dev/types/**/*.ts",
    ".next-review-final/types/**/*.ts",
    ".next-review-final/dev/types/**/*.ts",
    ".next-review-3005/types/**/*.ts",
    ".next-review-3005/dev/types/**/*.ts",
    ".next-review-3006/types/**/*.ts",
    ".next-review-3006/dev/types/**/*.ts",
    ".next-review-publicacoes/types/**/*.ts",
    ".next-review-publicacoes/dev/types/**/*.ts",
    ".next-review-publicacoes2/types/**/*.ts",
    ".next-review-publicacoes2/dev/types/**/*.ts",
    ".next-review-orange/types/**/*.ts",
    ".next-review-orange/dev/types/**/*.ts",
    ".next-review-tag-picker/types/**/*.ts",
    ".next-review-tag-picker/dev/types/**/*.ts",
    ".next-review-header-formula/types/**/*.ts",
    ".next-review-header-formula/dev/types/**/*.ts",
    ".next-review-quote-standard/types/**/*.ts",
    ".next-review-quote-standard/dev/types/**/*.ts",
    ".next-review-internal-links/types/**/*.ts",
    ".next-review-internal-links/dev/types/**/*.ts",
    ".next-review-link-ux/types/**/*.ts",
    ".next-review-link-ux/dev/types/**/*.ts",
    ".next-review-link-ux2/types/**/*.ts",
    ".next-review-link-ux2/dev/types/**/*.ts",
    ".next-home-photo/types/**/*.ts",
    ".next-home-photo/dev/types/**/*.ts",
    ".next-authors/types/**/*.ts",
    ".next-authors/dev/types/**/*.ts",
    ".next-author-style/types/**/*.ts",
    ".next-author-style/dev/types/**/*.ts",
    ".next-footnote-links/types/**/*.ts",
    ".next-footnote-links/dev/types/**/*.ts",
    ".next-word-export/types/**/*.ts",
    ".next-word-export/dev/types/**/*.ts",
    ".next-watermark/types/**/*.ts",
    ".next-watermark/dev/types/**/*.ts",
    ".next-local-preview-access/types/**/*.ts",
    ".next-local-preview-access/dev/types/**/*.ts",
    ".next-fichamento-structured-validation/types/**/*.ts",
    ".next-fichamento-structured-validation/dev/types/**/*.ts",
    ".next-build-check/types/**/*.ts",
    ".next-build-check/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "worker",
    ".next-preview*",
    ".next-review*"
  ]
}
