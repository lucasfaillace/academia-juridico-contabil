# Copie para .env, use chmod 600 .env e nunca envie o arquivo ao Git.
COMPOSE_PROJECT_NAME=academia-juridico-contabil
APP_IMAGE_TAG=local
APP_PORT=3000

# Origem pública canônica, sem barra no fim e sem www. A variante www deve
# redirecionar no CloudPanel/Nginx antes de alcançar a aplicação.
NEXT_PUBLIC_SITE_URL=https://academia.exemplo.br

# Google Analytics 4 opcional. Funciona como fallback inicial; depois pode ser
# ativado, alterado ou desativado no painel sem reconstruir a aplicação.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cloudflare é opcional. Deixe desativado se não utilizar o serviço.
# O token, quando configurado, deve possuir somente a permissão Cache Purge para esta zona.
CLOUDFLARE_CACHE_PURGE_ENABLED=false
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# PostgreSQL interno. Use apenas letras, números, ponto, hífen e sublinhado
# em POSTGRES_USER/POSTGRES_DB. A senha pode ser gerada com: openssl rand -base64 36
POSTGRES_DB=academia
POSTGRES_USER=academia
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
PGPOOL_MAX=10

# Limites administrativos de exportação em lote. Aumente somente após medir
# memória e tempo de resposta na VPS; a exportação individual não é afetada.
MAX_BULK_ARTICLE_EXPORT=200
MAX_REFERENCE_EXPORT=2000
MAX_FICHAMENTO_EXPORT=5000

# Gere com: openssl rand -hex 64
AUTH_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO

# Opcional e apenas local. Quando vazio, a prévia grava em storage/preview.
PREVIEW_DATA_DIR=

# Gere separadamente com: openssl rand -hex 64
# Usado apenas para anonimizar e deduplicar visualizações por até 48 horas.
ANALYTICS_HASH_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO

# Administrador único inicial. Gere o hash conforme DEPLOYMENT.md. O script grava
# o valor entre aspas duplas e escapa cada `$` como `\$`, preservando o hash
# original tanto no Next local quanto na interpolação do Docker Compose.
ADMIN_EMAIL=admin@exemplo.br
ADMIN_PASSWORD_HASH="SUBSTITUA_PELO_HASH_SCRYPT"
DEFAULT_AUTHOR_NAME=Nome do autor

# SMTP. Obrigatório para o formulário de contato funcionar em produção.
SMTP_HOST=smtp.exemplo.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASSWORD=SUBSTITUA_POR_SENHA_SMTP
CONTACT_FROM=academia@exemplo.br
CONTACT_TO=contato@academiajuridicocontabil.com.br
