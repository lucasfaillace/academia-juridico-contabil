# Substitua academia.exemplo.br e www.academia.exemplo.br antes de instalar.
limit_req_zone $binary_remote_addr zone=academia_contact:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=academia_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name academia.exemplo.br www.academia.exemplo.br;

    client_max_body_size 16m;
    server_tokens off;
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types application/javascript application/json application/manifest+json application/xml image/svg+xml text/css text/plain text/xml;

    access_log /var/log/nginx/academia.access.log;
    error_log /var/log/nginx/academia.error.log warn;

    location /api/contact {
        limit_req zone=academia_contact burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    location = /api/auth/login {
        limit_req zone=academia_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /media/ {
        proxy_pass http://127.0.0.1:3000;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }

    location ~ /\. {
        deny all;
    }
}
