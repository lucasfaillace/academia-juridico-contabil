# Referência para o Vhost Editor do CloudPanel.
# Substitua academia.exemplo.br e www.academia.exemplo.br pelo domínio real.
# Preserve no vhost as diretivas listen, SSL e logs geradas pelo CloudPanel.
#
# As quatro diretivas abaixo pertencem ao contexto http global do Nginx. Elas
# não podem ser coladas dentro de server/location no Vhost Editor. Configure-as
# uma única vez na área global do Nginx/CloudPanel antes de usar limit_req.
limit_req_zone $binary_remote_addr zone=academia_contact:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=academia_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=academia_comments:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=academia_views:10m rate=60r/m;

# Vhost alternativo: não encaminha requisições ao Next.js. No CloudPanel,
# mantenha também aqui as diretivas de HTTPS geradas para o certificado que
# cobre www.academia.exemplo.br.
server {
    listen 80;
    listen [::]:80;
    server_name www.academia.exemplo.br;

    return 308 https://academia.exemplo.br$request_uri;
}

# Vhost canônico: este é o único que encaminha requisições ao Next.js.
server {
    listen 80;
    listen [::]:80;
    server_name academia.exemplo.br;

    # O arquivo PDF é limitado a 20 MiB pela aplicação; 1 MiB adicional
    # acomoda o envelope multipart sem ampliar o limite efetivo do arquivo.
    client_max_body_size 21m;
    server_tokens off;
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types application/javascript application/json application/manifest+json application/xml image/svg+xml text/css text/plain text/xml;

    access_log /var/log/nginx/academia.access.log;
    error_log /var/log/nginx/academia.error.log warn;

    location /api/contact {
        limit_req zone=academia_contact burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header CF-Connecting-IP "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    location = /api/auth/login {
        limit_req zone=academia_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header CF-Connecting-IP "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    location ~ ^/api/articles/[^/]+/comments$ {
        limit_req zone=academia_comments burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header CF-Connecting-IP "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    location ~ ^/api/articles/[^/]+/views$ {
        limit_req zone=academia_views burst=20 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header CF-Connecting-IP "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header CF-Connecting-IP "";
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /media/ {
        proxy_pass http://127.0.0.1:3000;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header CF-Connecting-IP "";
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }

    location ~ /\. {
        deny all;
    }
}
